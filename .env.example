# ===================
# Server Config
# ===================
PORT=3000
BASE_URL=http://localhost:3000

# ===================
# MongoDB
# ===================
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# ===================
# Redis (Upstash or local)
# ===================
REDIS_URL=redis://default:<password>@<host>:<port>
